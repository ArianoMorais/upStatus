{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "upstatus",
    "Audience": "upstatus",
    "ExpirationHours": 8
  },
  "Worker": {
    "TickIntervalMs": 1000,
    "MaxConcurrentChecks": 20,
    "DefaultCooldownSeconds": 300
  }
}
